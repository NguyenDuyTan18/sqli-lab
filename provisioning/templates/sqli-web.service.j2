[Unit]
Description=Range Shop intentionally vulnerable SQL injection exercise
After=network-online.target
Wants=network-online.target

[Service]
User=sqli-web
Group=sqli-web
WorkingDirectory=/var/lib/sqli-lab
ExecStart=/usr/bin/python3 /opt/sqli-lab/app.py --host 0.0.0.0 --port 8080 --db /var/lib/sqli-lab/lab.db{% if sqli_search_fixed | bool %} --fixed{% endif %}

Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sqli-lab

[Install]
WantedBy=multi-user.target
