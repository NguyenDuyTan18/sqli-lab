# Merge task into ForcAD config.yml. Set game.start_time before setup.
game:
  mode: classic
  start_time: 2026-10-28 10:00:00
  timezone: Asia/Bangkok
  round_time: 60
  flag_lifetime: 5
tasks:
  - name: sqli_shop
    checker: sqli_shop/checker.py
    checker_type: pfr
    checker_timeout: 15
    puts: 1
    gets: 1
    places: 1
teams:
  # Every service runs in the same sandbox on a separate team VM.
  # Direct routed access only; Docker must be able to reach these addresses.
  - name: Team 1
    ip: 10.20.10.11:8080
  - name: Team 2
    ip: 10.20.10.12:8080
  - name: Team 3
    ip: 10.20.10.13:8080
  - name: Team 4
    ip: 10.20.10.14:8080
